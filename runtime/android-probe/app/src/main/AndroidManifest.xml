            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name=".AgentProbeService" android:exported="false" android:process=":agent" android:foregroundServiceType="dataSync" />
    </application>
</manifest>
