{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "历史穿越",
  "version": "0.8.0",
  "identifier": "io.timejump.chuanyue",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "历史穿越",
        "width": 1100,
        "height": 800,
        "minWidth": 420,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#efe5cf"
      }
    ],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "历史穿越：AI 互动小说",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
