{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal application window permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:app:allow-register-listener",
    "core:app:allow-remove-listener",
    "core:app:allow-exit"
  ]
}
