{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal application window permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:app:allow-register-listener",
    "core:app:allow-remove-listener",
    "core:app:allow-exit",
    "notifications:allow-request-notification-permission",
    "notifications:allow-notification-status",
    "notifications:allow-open-notification-settings",
    "notifications:allow-open-app-settings",
    "notifications:allow-story-committed",
    "notifications:allow-set-keep-awake",
    "notifications:allow-open-url",
    "notifications:allow-set-system-bars",
    "notifications:allow-haptic",
    "notifications:allow-background-status",
    "notifications:allow-request-battery-exemption",
    "notifications:allow-open-autostart-settings",
    "notifications:allow-set-notify-prefs",
    "notifications:allow-take-launch-target",
    "updates:allow-download",
    "updates:allow-cancel",
    "updates:allow-fetch-text",
    "updates:allow-install",
    "updates:allow-can-install",
    "updates:allow-dev-source",
    "updates:allow-set-dev-source"
  ]
}
