<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_splash_logo">

    <target
        android:name="arc_group"
        android:animation="@animator/splash_arc_anim" />

    <target
        android:name="seal_group"
        android:animation="@animator/splash_seal_anim" />

    <target android:name="seal_shadow">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="380"
                android:interpolator="@android:anim/decelerate_interpolator"
                android:propertyName="fillAlpha"
                android:valueFrom="0.2"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="seal_body">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="380"
                android:interpolator="@android:anim/decelerate_interpolator"
                android:propertyName="fillAlpha"
                android:valueFrom="0.2"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="seal_detail">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="380"
                android:interpolator="@android:anim/decelerate_interpolator"
                android:propertyName="fillAlpha"
                android:valueFrom="0.2"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
